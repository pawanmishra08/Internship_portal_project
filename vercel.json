{
  "experimentalServices": {
    "builds": [{
      "src": "internship_portal/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }],
    "routes":[{
      "src": "/(.*)",
      "dest": "internship_portal/wsgi.py"
    }],
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_backend"
    }
  }
}